generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deliveryOrdersCreated DeliveryOrder[] @relation("CreatedByUser")
  inventoryEntries      InventoryLedger[] @relation("CreatedByUser")
  approvedReports       SellThroughReport[] @relation("ApprovedByUser")
  auditLogs             AuditLog[]
}

enum UserRole {
  ADMIN
  RETAILER
}

model Product {
  id              String   @id @default(uuid())
  skuCode         String   @unique @map("sku_code")
  name            String
  category        String?
  description     String?
  msrp            Decimal  @db.Decimal(10, 2)
  weightKg        Decimal? @map("weight_kg") @db.Decimal(6, 2)
  barcode         String?
  shopifyVariantId String? @map("shopify_variant_id")
  isActive        Boolean  @default(true) @map("is_active")
  imageUrl        String?  @map("image_url")
  lowStockThreshold Int    @default(10) @map("low_stock_threshold")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  retailerPricing     RetailerPricing[]
  deliveryOrderItems  DeliveryOrderLineItem[]
  inventoryLedger     InventoryLedger[]
  sellThroughItems    SellThroughLineItem[]
  invoiceLineItems    InvoiceLineItem[]
  supplierOrderItems  SupplierOrderLineItem[]

  @@map("products")
}

model Retailer {
  id            String       @id @default(uuid())
  name          String
  code          String       @unique
  contactPerson String?      @map("contact_person")
  email         String       @unique
  phone         String?
  address       String?
  type          RetailerType
  paymentTerms  String?      @map("payment_terms")
  notes         String?
  isActive      Boolean      @default(true) @map("is_active")
  magicToken    String?      @unique @map("magic_token")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  outlets            Outlet[]
  pricing            RetailerPricing[]
  deliveryOrders     DeliveryOrder[]
  inventoryLedger    InventoryLedger[]
  sellThroughReports SellThroughReport[]
  invoices           Invoice[]

  @@map("retailers")
}

model Outlet {
  id            String   @id @default(uuid())
  retailerId    String   @map("retailer_id")
  name          String
  code          String
  address       String?
  contactPerson String?  @map("contact_person")
  phone         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  retailer            Retailer              @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  deliveryOrders      DeliveryOrder[]
  inventoryLedger     InventoryLedger[]
  sellThroughReports  SellThroughReport[]
  invoices            Invoice[]

  @@unique([retailerId, code])
  @@map("outlets")
}

enum RetailerType {
  BUYOUT
  CONSIGNMENT
}

model RetailerPricing {
  id           String    @id @default(uuid())
  retailerId   String    @map("retailer_id")
  productId    String    @map("product_id")
  unitPrice    Decimal   @map("unit_price") @db.Decimal(10, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo  DateTime? @map("effective_to") @db.Date

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([retailerId, productId, effectiveFrom])
  @@map("retailer_pricing")
}

model DeliveryOrder {
  id              String          @id @default(uuid())
  doNumber        String          @unique @map("do_number")
  retailerId      String          @map("retailer_id")
  outletId        String?         @map("outlet_id")
  orderDate       DateTime        @map("order_date") @db.Date
  deliveryDate    DateTime?       @map("delivery_date") @db.Date
  status          DOStatus        @default(DRAFT)
  notes           String?
  sourceReference String?         @map("source_reference")
  subtotal        Decimal         @default(0) @map("subtotal") @db.Decimal(10, 2)
  createdById     String          @map("created_by")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  retailer  Retailer                @relation(fields: [retailerId], references: [id])
  outlet    Outlet?                 @relation(fields: [outletId], references: [id])
  createdBy User                    @relation("CreatedByUser", fields: [createdById], references: [id])
  lineItems DeliveryOrderLineItem[]

  @@index([status], map: "delivery_orders_status_idx")
  @@index([retailerId], map: "delivery_orders_retailer_id_idx")
  @@index([createdAt], map: "delivery_orders_created_at_idx")
  @@map("delivery_orders")
}

enum DOStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
}

model DeliveryOrderLineItem {
  id              String  @id @default(uuid())
  deliveryOrderId String  @map("delivery_order_id")
  productId       String  @map("product_id")
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(10, 2)

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([deliveryOrderId], map: "delivery_order_line_items_do_id_idx")
  @@index([productId], map: "delivery_order_line_items_product_id_idx")
  @@map("delivery_order_line_items")
}

model InventoryLedger {
  id             String        @id @default(uuid())
  productId      String        @map("product_id")
  retailerId     String?       @map("retailer_id")
  outletId       String?       @map("outlet_id")
  quantityChange Int           @map("quantity_change")
  movementType   MovementType  @map("movement_type")
  referenceType  String?       @map("reference_type")
  referenceId    String?       @map("reference_id")
  notes          String?
  createdById    String        @map("created_by")
  createdAt      DateTime      @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  retailer Retailer? @relation(fields: [retailerId], references: [id])
  outlet   Outlet?   @relation(fields: [outletId], references: [id])
  createdBy User     @relation("CreatedByUser", fields: [createdById], references: [id])

  @@index([productId], map: "inventory_ledger_product_id_idx")
  @@index([retailerId], map: "inventory_ledger_retailer_id_idx")
  @@index([outletId], map: "inventory_ledger_outlet_id_idx")
  @@index([createdAt], map: "inventory_ledger_created_at_idx")
  @@map("inventory_ledger")
}

enum MovementType {
  RESTOCK
  DISPATCH_TO_RETAILER
  RECEIVE_AT_RETAILER
  SELL_THROUGH
  RETURN_TO_SOYCRAFT
  DAMAGE_WRITEOFF
  ADJUSTMENT
}

model SellThroughReport {
  id             String              @id @default(uuid())
  retailerId     String              @map("retailer_id")
  outletId       String?             @map("outlet_id")
  reportingMonth DateTime            @map("reporting_month") @db.Date
  status         SellThroughStatus   @default(DRAFT)
  submittedAt    DateTime?           @map("submitted_at")
  approvedById   String?             @map("approved_by")
  approvedAt     DateTime?           @map("approved_at")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  retailer   Retailer              @relation(fields: [retailerId], references: [id])
  outlet     Outlet?               @relation(fields: [outletId], references: [id])
  approvedBy User?                 @relation("ApprovedByUser", fields: [approvedById], references: [id])
  lineItems  SellThroughLineItem[]

  @@map("sell_through_reports")
}

enum SellThroughStatus {
  DRAFT
  SUBMITTED
  APPROVED
  INVOICED
}

model SellThroughLineItem {
  id           String  @id @default(uuid())
  reportId     String  @map("report_id")
  productId    String  @map("product_id")
  quantitySold Int     @map("quantity_sold")
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(10, 2)

  report  SellThroughReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id])

  @@map("sell_through_line_items")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  retailerId    String        @map("retailer_id")
  outletId      String?       @map("outlet_id")
  invoiceDate   DateTime      @map("invoice_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  billingMonth  DateTime      @map("billing_month") @db.Date
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(10, 2)
  gstRate       Decimal       @default(0.09) @map("gst_rate") @db.Decimal(4, 2)
  gstAmount     Decimal       @default(0) @map("gst_amount") @db.Decimal(10, 2)
  total         Decimal       @default(0) @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(10, 2)
  notes            String?
  sourceReference  String?            @map("source_reference")
  sourceType       InvoiceSourceType? @map("source_type")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  retailer  Retailer        @relation(fields: [retailerId], references: [id])
  outlet    Outlet?         @relation(fields: [outletId], references: [id])
  lineItems InvoiceLineItem[]

  @@index([status], map: "invoices_status_idx")
  @@index([retailerId], map: "invoices_retailer_id_idx")
  @@index([billingMonth], map: "invoices_billing_month_idx")
  @@index([createdAt], map: "invoices_created_at_idx")
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum InvoiceSourceType {
  DELIVERY_ORDERS
  SELL_THROUGH
}

model InvoiceLineItem {
  id            String  @id @default(uuid())
  invoiceId     String  @map("invoice_id")
  productId     String? @map("product_id")
  description   String?
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(10, 2)
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId], map: "invoice_line_items_invoice_id_idx")
  @@index([productId], map: "invoice_line_items_product_id_idx")
  @@map("invoice_line_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

model Settings {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Supplier Orders (standalone module)
// ---------------------------------------------------------------------------

model Supplier {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  address       String?
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplierOrders SupplierOrder[]
  financeEntries FinanceEntry[]

  @@map("suppliers")
}

model SupplierOrder {
  id                   String        @id @default(uuid())
  soNumber             String        @unique @map("so_number")
  supplierId           String        @map("supplier_id")
  orderDate            DateTime      @map("order_date") @db.Date
  expectedDeliveryDate DateTime?     @map("expected_delivery_date") @db.Date
  actualDeliveryDate   DateTime?     @map("actual_delivery_date") @db.Date
  status               SOStatus      @default(ORDERED)
  paymentStatus        SOPaymentStatus @default(UNPAID) @map("payment_status")
  amountPaid           Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  notes                String?
  subtotal             Decimal       @default(0) @db.Decimal(12, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  supplier       Supplier                  @relation(fields: [supplierId], references: [id])
  lineItems      SupplierOrderLineItem[]
  financeEntries FinanceEntry[]
  adjustments    SupplierOrderAdjustment[]

  @@index([status], map: "supplier_orders_status_idx")
  @@index([supplierId], map: "supplier_orders_supplier_id_idx")
  @@index([orderDate], map: "supplier_orders_order_date_idx")
  @@index([createdAt], map: "supplier_orders_created_at_idx")
  @@map("supplier_orders")
}

model SupplierOrderAdjustment {
  id              String   @id @default(uuid())
  supplierOrderId String   @map("supplier_order_id")
  lineItemId      String?  @map("line_item_id")
  productSku      String   @map("product_sku")
  productName     String   @map("product_name")
  delta           Int
  qtyBefore       Int      @map("qty_before")
  qtyAfter        Int      @map("qty_after")
  reason          String
  createdAt       DateTime @default(now()) @map("created_at")

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([supplierOrderId])
  @@map("supplier_order_adjustments")
}

enum SOStatus {
  ORDERED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum SOPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model SupplierOrderLineItem {
  id              String   @id @default(uuid())
  supplierOrderId String   @map("supplier_order_id")
  // Either productId (catalog stock item) OR description (ad-hoc, e.g.
  // packaging, freight). Enforced at the action layer via Zod refinement.
  productId       String?  @map("product_id")
  description     String?
  orderedQty      Int      @map("ordered_qty")
  receivedQty     Int?     @map("received_qty")
  unitCost        Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([supplierOrderId], map: "supplier_order_line_items_so_id_idx")
  @@index([productId], map: "supplier_order_line_items_product_id_idx")
  @@map("supplier_order_line_items")
}

// ---------------------------------------------------------------------------
// Finance Tracker (standalone module)
// ---------------------------------------------------------------------------

model FinanceEntry {
  id                 String              @id @default(uuid())
  category           FinanceCategory
  entryDate          DateTime             @map("entry_date") @db.Date
  amount             Decimal              @db.Decimal(12, 2)
  description        String?
  notes              String?

  // INVENTORY-specific
  supplierId         String?              @map("supplier_id")
  supplierOrderId    String?              @map("supplier_order_id")

  // EVENT-specific
  eventName          String?              @map("event_name")
  eventSubCategory   EventSubCategory?    @map("event_sub_category")

  // OTHER-specific
  otherSubCategoryId String?              @map("other_sub_category_id")

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  supplierOrder    SupplierOrder?      @relation(fields: [supplierOrderId], references: [id])
  otherSubCategory OtherSubCategory?   @relation(fields: [otherSubCategoryId], references: [id])

  @@index([category, entryDate])
  @@index([supplierId], map: "finance_entries_supplier_id_idx")
  @@index([supplierOrderId], map: "finance_entries_supplier_order_id_idx")
  @@index([entryDate], map: "finance_entries_entry_date_idx")
  @@map("finance_entries")
}

enum FinanceCategory {
  INVENTORY
  EVENT
  OTHER
}

enum EventSubCategory {
  BOOTH_FEE
  LOGISTICS
  TRAVEL
  MARKETING
  OTHER
}

model OtherSubCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())

  entries FinanceEntry[]

  @@map("other_sub_categories")
}
